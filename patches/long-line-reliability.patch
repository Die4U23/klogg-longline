+bool QuickFind::canSearchLine( LineNumber line )
+{
+    if ( interruptRequested_ || line >= searchLineCount_ ) return false;
+    const auto bytes = searchSource_->lineByteSize( sourceLine( line ) );
+    if ( bytes < 0 || bytes > AbstractLogData::PreviewByteLimit ) {
+        interruptRequested_.set();
+        sendNotification( QFNotification( tr( "Quick Find cannot search this long line. Use case-sensitive literal main search; preview is a byte window." ) ) );
+        return false;
+    }
+    return true;
+}
+
+bool QuickFind::prepareSource()
+{
+    searchSource_ = logData_.previewSource();
+    searchLineCount_ = logData_.getNbLine();
+    searchLines_.clear();
+    if ( searchSource_ != &logData_ ) {
+        if ( searchLineCount_.get() > 65536 ) {
+            sendNotification( QFNotification( tr( "Quick Find in a filtered view is limited to 65536 stable rows; use main search" ) ) );
+            return false;
+        }
+        searchLines_.reserve( static_cast<size_t>( searchLineCount_.get() ) );
+        for ( uint64_t i = 0; i < searchLineCount_.get(); ++i )
+            searchLines_.push_back( logData_.previewSourceLine( LineNumber( i ) ) );
+    }
+    return true;
+}
+
+LineNumber QuickFind::sourceLine( LineNumber line ) const
+{
+    return searchSource_ == &logData_ ? line : searchLines_.at( static_cast<size_t>( line.get() ) );
