+void AbstractLogView::clearPreview()
+{
+    ++previewRevision_;
+    if ( previewCancel_ ) previewCancel_->store( true );
+    previewFrame_.reset();
+}
+
+void AbstractLogView::stopPreview()
+{
+    ++previewRevision_;
+    if ( previewCancel_ ) previewCancel_->store( true );
+    previewWatcher_.waitForFinished();
+    if ( quickFind_ ) quickFind_->stopSearch();
+}
+
+quint64 AbstractLogView::previewRetainedBytes() const
+{
+    quint64 bytes = static_cast<quint64>( wrappedLinesInfo_.capacity() * sizeof( WrappedLineData ) );
+    if ( previewFrame_ ) {
+        bytes += static_cast<quint64>( previewFrame_->lines.capacity() * sizeof( AbstractLogData::LinePreview ) );
+        for ( const auto& preview : previewFrame_->lines )
+            bytes += static_cast<quint64>( preview.text.capacity() + preview.error.capacity() ) * sizeof( QChar );
+    }
+    OptionalLineNumber previous;
+    for ( const auto& row : wrappedLinesInfo_ ) {
+        if ( !previous || *previous != row.lineNumber ) bytes += row.wrappedString.retainedBytes();
+        previous = row.lineNumber;
+    }
+    return bytes; // excludes worker scratch, allocator overhead, pixmaps and other Qt objects
+}
+
+QString AbstractLogView::previewWindowText( quint64 viewLine ) const
+{
+    const auto preview = cachedPreview( LineNumber( viewLine ) );
+    return preview && preview->error.isEmpty() ? preview->text : QString{};
+}
+
+QVariantMap AbstractLogView::previewWindowInfo( quint64 viewLine ) const
+{
+    const auto preview = cachedPreview( LineNumber( viewLine ) );
+    if ( !preview ) return { { "ready", false } };
+    return { { "ready", true }, { "absolute_line_begin", preview->absoluteLineBegin },
+             { "byte_begin", preview->byteBegin }, { "byte_end", preview->byteEnd },
+             { "total_bytes", preview->totalBytes }, { "truncated", preview->truncated },
+             { "error", preview->error }, { "text_utf16_units", preview->text.size() } };
+}
+
+const AbstractLogData::LinePreview* AbstractLogView::cachedPreview( LineNumber line ) const
+{
+    if ( !previewFrame_ || previewFrame_->revision != previewRevision_ || line < previewFrame_->first )
+        return nullptr;
+    const auto index = ( line - previewFrame_->first ).get();
+    if ( index >= previewFrame_->lines.size() ) return nullptr;
+    return &previewFrame_->lines[ static_cast<size_t>( index ) ];
+}
+
+void AbstractLogView::requestPreview( LineNumber first, LinesCount count )
+{
+    if ( previewFrame_ && previewFrame_->first == first && previewFrame_->count == count
+         && previewFrame_->revision == previewRevision_ ) return;
+    if ( previewPending_ ) {
+        if ( previewFrame_ && previewFrame_->first != first && previewCancel_ ) previewCancel_->store( true );
+        return;
+    }
+    previewPending_ = true;
+    previewCancel_ = std::make_shared<std::atomic_bool>( false );
+    const auto cancel = previewCancel_;
+    const auto sourceData = logData_->previewSource();
+    const auto rawSource = qobject_cast<const LogData*>( sourceData );
+    const auto expected = rawSource ? rawSource->snapshot() : LogData::SourceSnapshot{};
+    klogg::vector<std::pair<LineNumber, qint64>> tasks;
+    const auto rows = std::min<uint64_t>( count.get(), 256 );
+    tasks.reserve( static_cast<size_t>( rows ) );
+    for ( uint64_t i = 0; i < rows; ++i ) {
+        const auto viewLine = first + LinesCount( i );
+        const auto found = previewOffsets_.find( viewLine );
+        tasks.emplace_back( logData_->previewSourceLine( viewLine ),
+                            found == previewOffsets_.end() ? 0 : found->second );
+    }
+    const auto revision = previewRevision_;
+    previewWatcher_.setFuture( QtConcurrent::run( [ sourceData, rawSource, expected, first, count, tasks = std::move( tasks ), revision, cancel ] {
+        PreviewFrame frame{ first, count, revision, {} };
+        // Covers bounded source text; tab expansion is at most 8x and QString
+        // UTF-16 at most 2x these input bytes. Row metadata is separately capped.
+        qint64 remaining = 128 * 1024;
+        frame.lines.reserve( tasks.size() );
+        for ( const auto& task : tasks ) {
+            if ( cancel->load() ) break;
+            AbstractLogData::LinePreview preview;
+            if ( !rawSource || !rawSource->matchesSnapshot( expected ) )
+                preview.error = QObject::tr( "Source changed; refresh the file" );
+            else if ( remaining > 0 ) {
+                const auto reserved = std::min( remaining, AbstractLogData::PreviewByteLimit );
+                const auto requested = std::min( reserved,
+                    std::max<qint64>( 0, sourceData->lineByteSize( task.first ) - task.second ) );
+                preview = sourceData->linePreview( task.first, task.second,
+                                                  reserved );
+                remaining -= std::max<qint64>( 1, requested );
+            }
+            else preview.error = QObject::tr( "Preview budget reached; scroll to view this line" );
+            frame.lines.push_back( std::move( preview ) );
+        }
+        if ( rawSource && !rawSource->matchesSnapshot( expected ) ) {
+            for ( auto& preview : frame.lines ) {
+                preview.text.clear();
+                preview.error = QObject::tr( "Source changed; refresh the file" );
+            }
+        }
+        return frame;
+    } ) );
+}
+
+void AbstractLogView::showByteWindow( LineNumber viewLine, OffsetInFile absoluteByteAnchor )
+{
+    // Metadata/tiny bounded read only; the larger window is obtained asynchronously.
+    const auto metadata = logData_->linePreview( viewLine, 0, 1 );
+    if ( !metadata.error.isEmpty() ) {
+        Q_EMIT notifyQuickFind( QFNotification( metadata.error ) );
+        return;
+    }
+    const auto relative = std::clamp<qint64>( absoluteByteAnchor.get() <= metadata.absoluteLineBegin ? 0
+                                             : absoluteByteAnchor.get() - metadata.absoluteLineBegin,
+                                             0, metadata.totalBytes );
+    previewOffsets_.clear();
+    previewOffsets_[ viewLine ] = std::max<qint64>( 0, relative - 32 );
+    selection_.selectLine( viewLine );
+    clearPreview();
+    previewAnchor_ = std::make_pair( viewLine, relative );
+    horizontalScrollBar()->setValue( 0 );
+    jumpToLine( viewLine );
+    forceRefresh();
+}
+
+void AbstractLogView::nextByteWindow()
+{
+    const auto line = getViewPosition();
+    if ( const auto preview = cachedPreview( line ) ) {
+        if ( previewOffsets_.size() >= 8 ) previewOffsets_.clear();
+        previewOffsets_[ line ] = std::min( preview->byteEnd,
+                                           std::max<qint64>( 0, preview->totalBytes - 1 ) );
+        selection_.selectLine( line );
+        previewAnchor_.reset();
+        clearPreview();
+        horizontalScrollBar()->setValue( 0 );
+        forceRefresh();
+    }
+}
+
+void AbstractLogView::previousByteWindow()
+{
+    const auto line = getViewPosition();
+    if ( const auto preview = cachedPreview( line ) ) {
+        if ( previewOffsets_.size() >= 8 ) previewOffsets_.clear();
+        previewOffsets_[ line ] = std::max<qint64>( 0, preview->byteBegin - AbstractLogData::PreviewByteLimit );
+        selection_.selectLine( line );
+        previewAnchor_.reset();
+        clearPreview();
+        horizontalScrollBar()->setValue( 0 );
+        forceRefresh();
+    }
 }
 
